{
  "name": "dsh-web-search-router",
  "version": "0.1.0",
  "description": "Priority-ordered multi-provider web_search router for DeepSeek Harness with automatic fallback.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "web-search",
    "searxng",
    "deepseek",
    "tavily",
    "brave-search",
    "exa",
    "firecrawl",
    "parallel",
    "duckduckgo"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kerberos255/dsh-web-search-router.git"
  },
  "homepage": "https://github.com/Kerberos255/dsh-web-search-router#readme",
  "bugs": {
    "url": "https://github.com/Kerberos255/dsh-web-search-router/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-web-search-deepseek": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
